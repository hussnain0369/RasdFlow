---
/**
 * Accessible 1–5 star rating input (native radio group).
 * Arrow keys move between stars in reading order: left-to-right in English,
 * right-to-left in Arabic, and each star has a spoken label ("3 stars" / "3 نجوم").
 */
import { feedbackText } from '../content/feedback';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  legend: string;
  hint?: string;
  idPrefix: string;
  /** Text shown after the legend, e.g. "(required)". */
  note?: string;
}
const { lang, legend, hint, idPrefix, note } = Astro.props;
const f = feedbackText[lang].form;
const described = [hint ? `${idPrefix}-h-rating` : '', `${idPrefix}-e-rating`].filter(Boolean).join(' ');
---
<fieldset class="star-field" aria-describedby={described}>
  <legend>{legend}{note && <span class="req"> ({note})</span>}</legend>
  {hint && <p class="hint" id={`${idPrefix}-h-rating`}>{hint}</p>}
  <div class="rate">
    {
      [1, 2, 3, 4, 5].map((n) => (
        <label class="star">
          <input type="radio" name="rating" value={n} required />
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z" />
          </svg>
          <span class="visually-hidden">{f.starLabel(n)}</span>
        </label>
      ))
    }
    <span class="rate-value" aria-hidden="true"></span>
  </div>
  <p class="error" id={`${idPrefix}-e-rating`} hidden></p>
</fieldset>

<script>
  // Visible text for the chosen rating, matching the spoken label of the star.
  document.querySelectorAll<HTMLElement>('.rate').forEach((rate) => {
    const out = rate.querySelector<HTMLElement>('.rate-value');
    const error = rate.closest('fieldset')?.querySelector<HTMLElement>('.error');
    rate.querySelectorAll<HTMLInputElement>('input[name="rating"]').forEach((r) =>
      r.addEventListener('change', () => {
        if (out) out.textContent = r.parentElement?.querySelector('.visually-hidden')?.textContent ?? '';
        // A rating has been chosen: clear the "choose a rating" error straight away.
        if (error) error.hidden = true;
        rate.querySelectorAll('input').forEach((i) => i.setAttribute('aria-invalid', 'false'));
      }),
    );
    rate.closest('form')?.addEventListener('reset', () => {
      if (out) out.textContent = '';
    });
  });
</script>

<style>
  .star-field {
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    display: block;
    font-weight: 650;
    color: var(--navy);
    margin-block-end: 0.35rem;
    padding: 0;
  }
  .req {
    font-weight: 400;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .hint {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-block-end: 0.4rem;
  }
  .rate {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .star {
    position: relative;
    margin: 0;
    padding: 0.2rem;
    cursor: pointer;
    border-radius: var(--radius-s);
    line-height: 0;
  }
  .star input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .star svg {
    width: 2.5rem;
    height: 2.5rem;
    fill: var(--white);
    stroke: #8a6516;
    stroke-width: 1.4;
    stroke-linejoin: round;
    transition: fill 0.1s ease;
  }
  .star:has(input:focus-visible) {
    outline: 3px solid var(--blue);
    outline-offset: 1px;
  }
  .rate:hover .star:has(~ .star:hover) svg,
  .rate .star:hover svg {
    fill: #f3d58f;
  }
  .rate:has(input[value='1']:checked) .star:nth-child(-n + 1) svg,
  .rate:has(input[value='2']:checked) .star:nth-child(-n + 2) svg,
  .rate:has(input[value='3']:checked) .star:nth-child(-n + 3) svg,
  .rate:has(input[value='4']:checked) .star:nth-child(-n + 4) svg,
  .rate:has(input[value='5']:checked) .star:nth-child(-n + 5) svg {
    fill: #d99a1e;
  }
  .rate-value {
    margin-inline-start: 0.6rem;
    font-weight: 650;
    color: var(--navy);
  }
  .error {
    color: var(--error);
    font-size: var(--step--1);
    font-weight: 600;
    margin-block-start: 0.4rem;
  }
  @media (max-width: 30rem) {
    .star svg {
      width: 2.3rem;
      height: 2.3rem;
    }
  }
</style>
