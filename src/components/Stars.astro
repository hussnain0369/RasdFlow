---
/** Read-only star rating, announced as "4 out of 5 stars" / "4 من 5 نجوم". */
import { feedbackText } from '../content/feedback';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  rating: number;
}
const { lang, rating } = Astro.props;
const label = feedbackText[lang].stars(rating);
---
<span class="stars" role="img" aria-label={label}>
  {
    [1, 2, 3, 4, 5].map((n) => (
      <svg viewBox="0 0 24 24" aria-hidden="true" class:list={[{ on: n <= rating }]}>
        <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z" />
      </svg>
    ))
  }
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 0.15rem;
  }
  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: #b7791f;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  svg.on {
    fill: #d99a1e;
    stroke: #b7791f;
  }
</style>
