---
import type { Faq } from '../content/pages';
interface Props {
  faqs: Faq[];
  title: string;
  id?: string;
}
const { faqs, title, id = 'faq' } = Astro.props;
---
<section class="section" aria-labelledby={`${id}-title`}>
  <div class="wrap faq-layout">
    <h2 id={`${id}-title`}>{title}</h2>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 64rem) {
    .faq-layout {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
