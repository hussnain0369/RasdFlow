---
import EngineerBadge from './EngineerBadge.astro';
import Icon from './Icon.astro';
import { engineerTeaser } from '../content/extra';
import { path, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = engineerTeaser[lang];
---
<section class="teaser" aria-labelledby="engineer-teaser">
  <EngineerBadge lang={lang} size="s" />
  <div>
    <h2 id="engineer-teaser">{c.title}</h2>
    <p>{c.text}</p>
    <a class="link-arrow" href={path('engineer', lang)}>
      <span>{c.link}</span>
      <Icon name="arrow" />
    </a>
  </div>
</section>

<style>
  .teaser {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-inline-start: 6px solid var(--blue);
    border-radius: var(--radius-m);
    background: var(--white);
    max-width: 52rem;
  }
  h2 {
    font-size: var(--step-2);
  }
  p {
    margin-block: 0.6rem 1rem;
    max-width: 40rem;
  }
  @media (max-width: 30rem) {
    .teaser {
      grid-template-columns: 1fr;
    }
  }
</style>
