---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Sections from '../Sections.astro';
import MethodList from '../MethodList.astro';
import ServiceCards from '../ServiceCards.astro';
import RelatedLinks from '../RelatedLinks.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import repairPhoto from '../../assets/photos/repair-valve.jpg';
import thermalPhoto from '../../assets/photos/equipment-thermal.jpg';
import { content } from '../../content/pages';
import { findingsSection, openingSection, methodsFor, methodsSection, noBreakingSection, chargesSection, pipeworkSection } from '../../content/services';
import ProofSections from '../ProofSections.astro';
import Icon from '../Icon.astro';
import { business } from '../../config/business';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { absoluteUrl, siteUrl } from '../../config/site';
import { serviceJsonLd } from '../../lib/structured';

interface Props {
  lang: Lang;
  kind: 'detection' | 'repair';
}
const { lang, kind } = Astro.props;
const c = content[lang][kind];
const ui = t(lang);
const detection = kind === 'detection';
const image = detection ? thermalPhoto : repairPhoto;
const m = methodsSection[lang];
// The detailed customer process lives on How It Works; hub pages keep only what is specific to them.
const before = detection
  ? [c.sections[0], c.sections[1], c.sections[2], chargesSection(lang, 'detection')]
  : [pipeworkSection(lang), c.sections[0], c.sections[1], c.sections[2], chargesSection(lang, 'repair')];
const after = detection
  ? [noBreakingSection(lang), findingsSection(lang)]
  : [c.sections[3], openingSection(lang)];
// Repair has no methods block between the two groups, so it renders as one run.
const first = detection ? before : [...before, ...after];
const report = detection && business.sampleReport;
const reportLabel = lang === 'ar' ? 'اطّلع على نموذج تقرير فحص (بعد حذف بيانات العميل)' : 'See a sample inspection report (customer details removed)';
const service = serviceJsonLd({ name: c.h1, description: c.meta.description, url: absoluteUrl(path(kind, lang)), siteUrl, lang });
// Repair page: point customers who can see damp but not its source back to detection.
const unknownSource =
  lang === 'ar'
    ? {
        title: 'ترى رطوبة لكن لا تعرف مصدرها؟',
        text: 'الإصلاح يبدأ بعد تحديد مصدر التسرب. إذا كانت الرطوبة أو المياه ظاهرة ولم يُعرف مصدرها بعد، فابدأ بكشف التسربات أولًا حتى يعالج الإصلاح السبب الفعلي.',
        link: 'كشف تسربات المياه',
      }
    : {
        title: 'Can you see damp but not where it comes from?',
        text: 'A repair starts once the source has been identified. If damp or water is visible but its source is not yet known, start with leak detection so the repair addresses the actual cause.',
        link: 'Water Leak Detection',
      };
const specificTitle = detection
  ? lang === 'ar' ? 'خدمات كشف متخصصة' : 'Specific Detection Services'
  : lang === 'ar' ? 'خدمة إصلاح متخصصة' : 'Specific Repair Service';
---
<BaseLayout lang={lang} page={kind} title={c.meta.title} description={c.meta.description} jsonLd={[service]}>
  <PageHero lang={lang} page={kind} h1={c.h1} intro={c.intro} image={image} imageAlt={c.imageAlt} imageFocus={detection ? '62% 45%' : '45% 50%'} />

  <div class:list={['section', { 'section--joined': !detection }]}>
    <div class="wrap">
      <Sections sections={first} idPrefix="a" />
      {
        !detection && (
          <aside class="callout" aria-labelledby="unknown-source-title">
            <h2 id="unknown-source-title">{unknownSource.title}</h2>
            <p>{unknownSource.text}</p>
            <a class="link-arrow" href={path('detection', lang)}>
              <span>{unknownSource.link}</span>
              <Icon name="arrow" />
            </a>
          </aside>
        )
      }
    </div>
  </div>

  {
    detection && methodsFor(lang).length > 0 && (
      <section class="section section--mist" aria-labelledby="methods-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="methods-title">{m.title}</h2>
            <p>{m.intro}</p>
          </div>
          <MethodList lang={lang} variant="full" />
        </div>
      </section>
    )
  }

  <div class="section">
    <div class="wrap">
      {detection && <Sections sections={after} idPrefix="b" />}
      {report && (
        <p class="report">
          <a class="link-arrow" href={report}>
            <span>{reportLabel}</span>
          </a>
        </p>
      )}
      <div class="specific">
        <ServiceCards lang={lang} keys={detection ? ['hidden', 'underground'] : ['pipeRepair']} title={specificTitle} />
      </div>
      <RelatedLinks lang={lang} pages={detection ? ['repair', 'howItWorks', 'guide', 'areas', 'contact'] : ['detection', 'howItWorks', 'areas', 'contact']} />
    </div>
  </div>

  <ProofSections lang={lang} services={[kind]} />

  <div class="faq-wrap">
    <Faq faqs={c.faqs} title={ui.faqTitle} />
  </div>

  <CtaBand lang={lang} title={c.cta.title} text={c.cta.text} />
</BaseLayout>

<style>
  .section {
    padding-block-end: var(--space-section);
  }
  .section--joined {
    padding-block-end: 0;
  }
  .callout {
    margin-block-start: 2.5rem;
    padding: 1.5rem;
    background: var(--blue-tint);
    border-inline-start: 4px solid var(--blue);
    border-radius: var(--radius-s);
    max-width: 48rem;
  }
  .callout h2 {
    font-size: var(--step-1);
    margin-block-end: 0.5rem;
  }
  .callout p {
    margin-block-end: 0.75rem;
  }
  .report {
    padding-block: 0 2rem;
  }
  .specific {
    padding-block: 2.5rem;
    border-block-start: 1px solid var(--line);
  }
  .specific :global(h2) {
    font-size: var(--step-2);
  }
  .faq-wrap {
    border-block-start: 1px solid var(--line);
  }
</style>
