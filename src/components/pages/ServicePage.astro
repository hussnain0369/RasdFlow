---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Sections from '../Sections.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import repairPhoto from '../../assets/photos/repair-valve.jpg';
import thermalPhoto from '../../assets/photos/equipment-thermal.jpg';
import { content } from '../../content/pages';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { faqJsonLd } from '../../lib/structured';

interface Props {
  lang: Lang;
  kind: 'detection' | 'repair';
}
const { lang, kind } = Astro.props;
const c = content[lang][kind];
const ui = t(lang);
const image = kind === 'detection' ? thermalPhoto : repairPhoto;
---
<BaseLayout lang={lang} page={kind} title={c.meta.title} description={c.meta.description} jsonLd={[faqJsonLd(c.faqs, lang)]}>
  <PageHero lang={lang} page={kind} h1={c.h1} intro={c.intro} image={image} imageAlt={c.imageAlt} />

  <div class="section">
    <div class="wrap">
      <Sections sections={c.sections} />
    </div>
  </div>

  <div class="faq-wrap">
    <Faq faqs={c.faqs} title={ui.faqTitle} />
  </div>

  <CtaBand lang={lang} title={c.cta.title} text={c.cta.text} />
</BaseLayout>

<style>
  .section {
    padding-block-end: 0;
  }
  .faq-wrap :global(.section) {
    padding-block-start: 3rem;
  }
</style>
