---
import '@fontsource/instrument-serif/latin-400-italic.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import EngineerTeaser from '../EngineerTeaser.astro';
import Illustration from '../Illustration.astro';
import MethodList from '../MethodList.astro';
import ServiceCards from '../ServiceCards.astro';
import ProofSections from '../ProofSections.astro';
import ReviewsSection from '../ReviewsSection.astro';
import { methodsFor, methodsSection } from '../../content/services';
import { guideTeaser } from '../../content/extra';
import heroPhoto from '../../assets/photos/equipment-acoustic.jpg';
import repairPhoto from '../../assets/photos/repair-valve.jpg';
import { content } from '../../content/pages';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { contact, whatsappHref } from '../../config/business';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home;
const ui = t(lang);
const wa = whatsappHref(lang);
const ms = methodsSection[lang];
---
<BaseLayout lang={lang} page="home" title={c.meta.title} description={c.meta.description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="pill">
          <Icon name="pin" class="pill-icon" />
          <span>{c.eyebrow}</span>
        </p>
        <h1 id="hero-title">
          <span>{c.h1Lead}</span>
          {' '}
          <span class="accent">{c.h1Accent}</span>
        </h1>
        <p class="lede">{c.intro}</p>
        <div class="hero-actions" data-hides-fab>
          {
            (contact.phone || wa) ? (
              <div class="hero-ctas">
                {contact.phone && (
                  <a class="hero-btn hero-btn--call" href={contact.phone.href} data-contact="call" title={contact.phone.display}>
                    <Icon name="phone" />
                    <span>{c.ctaCall}</span>
                  </a>
                )}
                {wa && (
                  <a class="hero-btn hero-btn--wa" href={wa} data-contact="whatsapp" rel="noopener" target="_blank">
                    <Icon name="chat" />
                    <span>{c.ctaWa}</span>
                  </a>
                )}
              </div>
            ) : (
              <div class="hero-ctas">
                <a class="hero-btn hero-btn--call" href={path('contact', lang)}>
                  <span>{c.ctaPrimary}</span>
                </a>
              </div>
            )
          }
          {
            (contact.phone || wa) && (
              <a class="hero-link" href={path('contact', lang)}>
                <span>{c.ctaContactLink}</span>
                <Icon name="arrow" class="arrow" />
              </a>
            )
          }
        </div>
      </div>
      <div class="hero-media">
        <Illustration
          lang={lang}
          src={heroPhoto}
          alt={c.heroAlt}
          widths={[480, 760, 1100, 1448]}
          sizes="(min-width: 64rem) 45vw, 100vw"
          eager
          focus="40% 55%"
          imgClass="hero-img"
        />
      </div>
    </div>
  </section>

  <section class="engineer-band">
    <div class="wrap">
      <EngineerTeaser lang={lang} />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="signs-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="signs-title">{c.signs.title}</h2>
        <p>{c.signs.intro}</p>
      </div>
      <ul class="signs">
        {
          c.signs.items.map((item) => (
            <li>
              <span class="sign-icon">
                <Icon name={item.icon} />
              </span>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="signs-closing">{c.signs.closing}</p>
      <p class="signs-link">
        <a class="link-arrow" href={path('guide', lang)}>
          <span>{guideTeaser[lang]}</span>
          <Icon name="arrow" />
        </a>
      </p>
    </div>
  </section>

  {
    methodsFor(lang).length > 0 && (
      <section class="section" aria-labelledby="methods-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="methods-title">{ms.title}</h2>
            <p>{ms.intro}</p>
          </div>
          <MethodList lang={lang} variant="compact" />
          <p class="methods-link">
            <a class="link-arrow" href={path('detection', lang)}>
              <span>{ms.link}</span>
              <Icon name="arrow" />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--mist" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="services-title">{c.services.title}</h2>
      <div class="services">
        <article class="service">
          <Icon name="detect" class="service-icon" />
          <h3>{c.services.detection.title}</h3>
          <p>{c.services.detection.text}</p>
          <a class="link-arrow" href={path('detection', lang)}>
            <span>{c.services.detection.link}</span>
            <Icon name="arrow" />
          </a>
        </article>
        <article class="service">
          <Icon name="repair" class="service-icon" />
          <h3>{c.services.repair.title}</h3>
          <p>{c.services.repair.text}</p>
          <a class="link-arrow" href={path('repair', lang)}>
            <span>{c.services.repair.link}</span>
            <Icon name="arrow" />
          </a>
        </article>
      </div>
      <div class="specific">
        <ServiceCards lang={lang} keys={['hidden', 'underground', 'pipeRepair']} headingId="specific-title" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="steps-title">{c.steps.title}</h2>
      <ol class="pipe-steps">
        {
          c.steps.items.map((step, i) => (
            <li>
              <span class="joint" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="steps-link">
        <a class="link-arrow" href={path('howItWorks', lang)}>
          <span>{ui.nav.howItWorks}</span>
          <Icon name="arrow" />
        </a>
      </p>
    </div>
  </section>

  <ReviewsSection lang={lang} />

  <section class="section coverage" aria-labelledby="coverage-title">
    <div class="wrap coverage-grid">
      <Illustration
        lang={lang}
        src={repairPhoto}
        alt={c.services.repair.alt}
        widths={[480, 760, 1100]}
        sizes="(min-width: 56rem) 45vw, 100vw"
        focus="45% 50%"
        imgClass="coverage-img"
      />
      <div class="coverage-copy">
        <Icon name="pin" class="coverage-icon" />
        <h2 id="coverage-title">{c.coverage.title}</h2>
        <p>{c.coverage.text}</p>
        <a class="link-arrow" href={path('areas', lang)}>
          <span>{c.coverage.link}</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <ProofSections lang={lang} />

  <Faq faqs={c.faqs} title={ui.faqTitle} />

  <CtaBand lang={lang} title={c.finalCta.title} text={c.finalCta.text} />
</BaseLayout>

<style>
  /* ---------- Hero: dark navy, large stacked call buttons ---------- */
  .hero {
    background:
      radial-gradient(60rem 40rem at 85% 10%, rgba(8, 135, 218, 0.28), transparent 60%),
      linear-gradient(180deg, #072641 0%, #0a3052 100%);
    color: #c9dbea;
    padding-block: clamp(1.75rem, 1rem + 3vw, 5rem) clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }
  .hero-grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--white);
    font-weight: 650;
    font-size: var(--step--1);
    margin-block-end: 1.25rem;
  }
  .pill:lang(en) {
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .pill :global(.pill-icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: #5cb8f0;
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.1rem, 1.3rem + 3.8vw, 4.4rem);
    line-height: 1.02;
    max-width: 15ch;
  }
  .hero h1:lang(ar) {
    line-height: 1.3;
    max-width: 16ch;
  }
  .accent {
    color: #5cb8f0;
  }
  .accent:lang(en) {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: 0;
    font-size: 1.08em;
  }
  .hero .lede {
    margin-block-start: 1.25rem;
    color: #c9dbea;
    max-width: 36rem;
  }
  .hero-actions {
    margin-block-start: 2rem;
    max-width: 30rem;
  }
  /* Two primary actions side by side when each can be at least 10rem; stacked below that */
  .hero-ctas {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
  }
  :global([dir='rtl']) .hero-ctas {
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
  }
  .hero-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.5rem;
    padding: 0.6rem 0.75rem;
    white-space: nowrap;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .hero-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    flex: none;
  }
  /* Darkened water blue and WhatsApp green keep white text at AA contrast */
  .hero-btn--call {
    background: #0a79c2;
    color: var(--white);
    box-shadow: 0 8px 22px rgba(8, 135, 218, 0.3);
  }
  .hero-btn--call:hover {
    background: var(--blue-text);
    color: var(--white);
  }
  .hero-btn--wa {
    background: #138b4f;
    color: var(--white);
  }
  .hero-btn--wa:hover {
    background: #0f7542;
    color: var(--white);
  }
  .hero-btn:focus-visible,
  .hero-link:focus-visible {
    outline: 3px solid var(--white);
    outline-offset: 3px;
  }
  .hero-link {
    display: inline-block;
    margin-block-start: 1.1rem;
    padding-block: 0.6rem;
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: rgba(255, 255, 255, 0.5);
  }
  .hero-link:hover {
    color: #5cb8f0;
  }
  .hero-link :global(svg) {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    vertical-align: -0.2em;
    margin-inline-start: 0.4rem;
  }
  :global([dir='rtl']) .hero-link :global(.arrow) {
    transform: scaleX(-1);
  }
  @media (min-width: 48rem) {
    .hero-btn {
      min-height: 3.75rem;
      padding-inline: 1.1rem;
      font-size: 1.125rem;
    }
  }
  .hero-media :global(.hero-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: var(--radius-m);
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4.5rem;
    }
    .hero-media :global(.hero-img) {
      aspect-ratio: 5 / 6;
      object-position: 48% 50%;
    }
  }

  /* ---------- Engineer, directly under the hero ---------- */
  .engineer-band {
    padding-block: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    background: var(--white);
  }

  /* ---------- Signs ---------- */
  .signs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-block-start: 1px solid var(--line);
  }
  .signs li {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-block-end: 1px solid var(--line);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--navy);
    font-weight: 550;
    line-height: 1.4;
  }
  .sign-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue-text);
    border: 1px solid var(--line);
  }
  .sign-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  @media (min-width: 48rem) {
    .signs {
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }
  }
  @media (min-width: 72rem) {
    .signs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .steps-link {
    margin-block-start: 2.5rem;
  }
  .methods-link {
    margin-block-start: 2rem;
  }
  .specific {
    margin-block-start: 3.5rem;
  }
  .specific :global(h2) {
    font-size: var(--step-2);
  }
  .signs-link {
    margin-block-start: 1.25rem;
  }
  .signs-closing {
    margin-block-start: 2rem;
    max-width: 40rem;
    color: var(--ink);
  }

  /* ---------- Services ---------- */
  .services-title {
    max-width: 18ch;
    margin-block-end: 3rem;
  }
  .services {
    display: grid;
    gap: 3rem;
  }
  .service {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-block-start: 1.75rem;
    border-block-start: 4px solid var(--navy);
  }
  .service h3 {
    font-size: var(--step-2);
    font-stretch: 106%;
  }
  .service p {
    max-width: 34rem;
  }
  .service .link-arrow {
    margin-block-start: 0.5rem;
  }
  .service :global(.service-icon) {
    width: 2.75rem;
    height: 2.75rem;
    color: var(--blue);
    stroke-width: 1.5;
  }
  @media (min-width: 52rem) {
    .services {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* ---------- Pipe steps: the one bold device on the page ---------- */
  .steps-title {
    margin-block-end: 3rem;
  }
  .pipe-steps {
    --joint: 3.5rem;
    --pipe: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
    position: relative;
  }
  /* vertical pipe on small screens */
  .pipe-steps::before {
    content: '';
    position: absolute;
    inset-block: calc(var(--joint) / 2) calc(var(--joint) / 2);
    inset-inline-start: calc(var(--joint) / 2 - var(--pipe) / 2);
    width: var(--pipe);
    background: var(--blue);
    border-radius: var(--pipe);
  }
  .pipe-steps li {
    position: relative;
    padding-inline-start: calc(var(--joint) + 1.25rem);
    min-height: var(--joint);
  }
  .joint {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: var(--joint);
    height: var(--joint);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-weight: 800;
    font-size: 1.35rem;
    font-stretch: 112%;
    box-shadow: 0 0 0 6px var(--white), 0 0 0 9px var(--blue);
  }
  .pipe-steps h3 {
    font-size: var(--step-1);
    padding-block-start: 0.7rem;
    margin-block-end: 0.6rem;
  }
  .pipe-steps p {
    max-width: 30rem;
  }
  @media (min-width: 56rem) {
    .pipe-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
    .pipe-steps::before {
      inset-block: calc(var(--joint) / 2 - var(--pipe) / 2) auto;
      inset-inline: calc(var(--joint) / 2) calc((100% - 6rem) / 3 - var(--joint) / 2);
      width: auto;
      height: var(--pipe);
    }
    .pipe-steps li {
      padding-inline-start: 0;
      padding-block-start: calc(var(--joint) + 1.25rem);
    }
    .pipe-steps h3 {
      padding-block-start: 0;
    }
  }

  /* ---------- Coverage ---------- */
  .coverage-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .coverage :global(.coverage-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
  }
  .coverage-copy p {
    margin-block: 1.25rem 1.75rem;
    max-width: 34rem;
  }
  .coverage-copy :global(.coverage-icon) {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--blue);
    margin-block-end: 1rem;
  }
  @media (min-width: 56rem) {
    .coverage-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4.5rem;
    }
  }
</style>
