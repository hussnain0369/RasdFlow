---
/**
 * An image marked visibly as an illustration. The supplied photos are generated
 * images, so they are never presented as LeakFix staff, equipment or jobs.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { methodsSection } from '../content/services';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
  imgClass?: string;
  /** CSS object-position, chosen so the equipment stays in mobile crops. */
  focus?: string;
}
const { lang, src, alt, widths, sizes, eager = false, class: cls, imgClass, focus = '50% 50%' } = Astro.props;
---
<figure class:list={['illus', cls]} style={`--focus: ${focus}`}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class={imgClass}
  />
  <figcaption>{methodsSection[lang].illustration}</figcaption>
</figure>

<style>
  .illus {
    position: relative;
    margin: 0;
  }
  .illus :global(img) {
    object-position: var(--focus);
  }
  figcaption {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-start: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(4, 26, 46, 0.72);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
  }
</style>
