---
import { Image } from 'astro:assets';
import logo from '../assets/brand/leakfix-logo.png';
import Icon from './Icon.astro';
import { path, otherLang, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { contact, isDemoContact } from '../config/business';
import { buildMenu, type MenuGroup, type MenuLink } from '../i18n/menu';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
const ui = t(lang);
const alt = otherLang(lang);
const switchHref = path(page ?? 'home', alt);
// One menu for the desktop bar and the mobile drawer: Home, Services, About Us, Contact Us.
const menu = buildMenu(lang);
const isCurrent = (g: MenuGroup) => page !== null && (g.overview === page || g.links.some((l) => l.key === page));
const current = (l: MenuLink) => (l.key !== null && l.key === page ? 'page' : undefined);
const linkAttrs = (l: MenuLink) =>
  l.action === 'whatsapp'
    ? { 'data-contact': 'whatsapp', rel: 'noopener', target: '_blank' }
    : l.action === 'call'
      ? { 'data-contact': 'call' }
      : {};
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <Icon name="pin" class="topbar-icon" />
    <p>
      <span>{isDemoContact ? ui.trialBar : ui.topbar}</span>
      {
        contact.phone && !contact.phone.demo && (
          <>
            {' '}
            <a href={contact.phone.href} data-contact="call">
              {ui.topbarCall} <span class="ltr">{contact.phone.display}</span>
            </a>
          </>
        )
      }
    </p>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={path('home', lang)}>
      <Image src={logo} alt="LeakFix" width={168} densities={[1, 2]} loading="eager" class="brand-logo" />
      <span class="brand-tag">{lang === 'ar' ? 'كشف تسربات المياه وإصلاحها' : 'Water Leak Detection & Repair'}</span>
    </a>

    <div class="header-actions">
      <a class="lang-switch" href={switchHref} hreflang={alt} lang={alt} aria-label={ui.switchLabel}>
        <Icon name="globe" />
        <span>{ui.switchTo}</span>
      </a>
      {
        contact.phone && (
          <a class="btn btn--blue header-call" href={contact.phone.href} data-contact="call">
            <Icon name="phone" />
            <span>{ui.call}</span>
          </a>
        )
      }
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-haspopup="dialog" aria-label={ui.menuOpen}>
        <Icon name="menu" />
        <span class="menu-label" aria-hidden="true">{ui.menu}</span>
      </button>
    </div>

    <nav id="site-nav" class="site-nav" aria-label={ui.mainNav}>
      <ul>
        <li>
          <a href={menu.home.href} aria-current={current(menu.home)}>{menu.home.label}</a>
        </li>
        {
          menu.groups.map((g) => (
            <li class="has-drop">
              <button class="drop-toggle" class:list={{ 'is-current': isCurrent(g) }} type="button" aria-expanded="false" aria-controls={`nav-${g.id}`}>
                <span>{g.label}</span>
                <Icon name="chevron" class="chev" />
              </button>
              <ul id={`nav-${g.id}`} class="drop">
                {g.overview && (
                  <li>
                    <a href={path(g.overview, lang)} aria-current={g.overview === page ? 'page' : undefined}>
                      {ui.menuLabels[g.overview] ?? ui.nav[g.overview]}
                    </a>
                  </li>
                )}
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} aria-current={current(l)} {...linkAttrs(l)}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<!-- Mobile/tablet drawer (below 1024px). Outside the sticky header so it stacks above the floating contact controls. -->
<div class="drawer-root" data-drawer hidden>
  <div class="drawer-backdrop" data-drawer-close></div>
  <div id="nav-drawer" class="drawer" role="dialog" aria-modal="true" aria-label={ui.mainNav}>
    <div class="drawer-top">
      <button class="drawer-close" type="button" data-drawer-close aria-label={ui.menuClose}>
        <Icon name="close" />
      </button>
    </div>
    <a class="drawer-logo" href={path('home', lang)}>
      <Image src={logo} alt="LeakFix" width={132} densities={[1, 2]} />
    </a>
    <nav class="drawer-nav" aria-label={ui.mainNav}>
      <ul>
        <li>
          <a href={menu.home.href} aria-current={current(menu.home)}>{menu.home.label}</a>
        </li>
        {
          menu.groups.map((g) => {
            const open = isCurrent(g);
            const id = `drawer-${g.id}`;
            return (
              <li class="group">
                {g.overview ? (
                  <div class="group-row">
                    <a class="group-link" href={path(g.overview, lang)} aria-current={g.overview === page ? 'page' : undefined}>
                      {g.label}
                    </a>
                    <button
                      class="sub-toggle chev-only"
                      type="button"
                      aria-expanded={open ? 'true' : 'false'}
                      aria-controls={id}
                      aria-label={`${g.label}: ${ui.subMore}`}
                    >
                      <Icon name="chevron" class="chev" />
                    </button>
                  </div>
                ) : (
                  <button class="sub-toggle" type="button" aria-expanded={open ? 'true' : 'false'} aria-controls={id}>
                    <span>{g.label}</span>
                    <Icon name="chevron" class="chev" />
                  </button>
                )}
                <ul id={id} class="sub" hidden={!open}>
                  {g.links.map((l) => (
                    <li>
                      <a href={l.href} aria-current={current(l)} class:list={{ action: !!l.action }} {...linkAttrs(l)}>
                        {l.action && <Icon name={l.action === 'call' ? 'phone' : 'chat'} />}
                        <span>{l.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a class="drawer-lang" href={switchHref} hreflang={alt} lang={alt} aria-label={ui.switchLabel}>
      <Icon name="globe" />
      <span>{ui.switchTo}</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const root = document.querySelector<HTMLElement>('[data-drawer]');
  const drawer = root?.querySelector<HTMLElement>('.drawer');
  if (toggle && root && drawer) {
    const html = document.documentElement;
    const focusables = () =>
      [...drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null);
    let closing: number | undefined;

    const open = () => {
      window.clearTimeout(closing);
      root.hidden = false;
      // next frame so the slide-in transition runs
      requestAnimationFrame(() => root.classList.add('is-open'));
      html.classList.add('drawer-open');
      toggle.setAttribute('aria-expanded', 'true');
      drawer.querySelector<HTMLElement>('.drawer-close')?.focus();
    };
    const close = (restoreFocus = true) => {
      if (root.hidden) return;
      root.classList.remove('is-open');
      html.classList.remove('drawer-open');
      toggle.setAttribute('aria-expanded', 'false');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      closing = window.setTimeout(() => (root.hidden = true), reduce ? 0 : 250);
      if (restoreFocus) toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', open);
    root.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => close()));
    // Selecting a link closes the drawer (the page then navigates).
    drawer.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => close(false)));

    // Accordion groups: one open at a time.
    const groupToggles = [...drawer.querySelectorAll<HTMLButtonElement>('.sub-toggle')];
    const setGroup = (btn: HTMLButtonElement, open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    };
    groupToggles.forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        groupToggles.forEach((other) => other !== btn && setGroup(other, false));
        setGroup(btn, open);
      }),
    );

    // Escape closes; Tab stays inside the open drawer.
    document.addEventListener('keydown', (event) => {
      if (root.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    // Leaving the collapsed-menu width closes the drawer.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && close(false));
  }

  // Desktop dropdowns (Services, About Us, Contact Us): one open at a time; click or tap toggles,
  // Escape, a click elsewhere or tabbing away closes.
  const dropItems = [...document.querySelectorAll<HTMLElement>('.site-nav .has-drop')];
  const dropBtn = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('.drop-toggle')!;
  const setDrop = (item: HTMLElement, open: boolean) => {
    dropBtn(item).setAttribute('aria-expanded', String(open));
    item.classList.toggle('is-open', open);
  };
  const dropOpen = (item: HTMLElement) => item.classList.contains('is-open');
  dropItems.forEach((item) => {
    const btn = dropBtn(item);
    btn.addEventListener('click', () => {
      const next = !dropOpen(item);
      dropItems.forEach((other) => other !== item && setDrop(other, false));
      setDrop(item, next);
    });
    item.addEventListener('focusout', (event) => {
      const to = event.relatedTarget as Node | null;
      if (dropOpen(item) && to && !item.contains(to)) setDrop(item, false);
    });
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropOpen(item)) {
        event.stopPropagation();
        setDrop(item, false);
        btn.focus();
      }
    });
  });
  document.addEventListener('click', (event) => {
    dropItems.forEach((item) => dropOpen(item) && !item.contains(event.target as Node) && setDrop(item, false));
  });
</script>

<style>
  .topbar {
    background: #041a2e;
    color: #c9dbea;
    font-size: var(--step--1);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.6rem;
    padding-block: 0.45rem;
  }
  .topbar p {
    line-height: 1.4;
  }
  .topbar :global(.topbar-icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: #5cb8f0;
  }
  .topbar a {
    color: var(--white);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .topbar a:hover {
    color: #5cb8f0;
  }
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.97);
    border-block-end: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    min-height: 4.5rem;
    padding-block: 0.6rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand-logo {
    width: 132px;
    height: auto;
  }
  .brand-tag {
    font-size: 0.72rem;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    order: 2;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-m);
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line);
  }
  .lang-switch:lang(ar) {
    font-family: var(--font-ar);
  }
  .lang-switch:lang(en) {
    font-family: var(--font);
  }
  .lang-switch:hover {
    border-color: var(--navy);
    color: var(--navy);
  }
  .lang-switch :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .header-call {
    white-space: nowrap;
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius-m);
    background: var(--white);
    color: var(--navy);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .menu-toggle :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .site-nav {
    order: 3;
    flex-basis: 100%;
  }
  /* Below 1024px the drawer replaces the inline menu; without JavaScript the inline menu stays visible. */
  :global(.js) .site-nav {
    display: none;
  }
  :global(.no-js) .menu-toggle {
    display: none;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.75rem;
  }
  .site-nav a {
    display: block;
    padding: 0.8rem 0.25rem;
    border-block-end: 1px solid var(--line);
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav a[aria-current='page'] {
    color: var(--blue-text);
    box-shadow: inset 3px 0 0 var(--blue);
    padding-inline-start: 0.75rem;
  }
  :global([dir='rtl']) .site-nav a[aria-current='page'] {
    box-shadow: inset -3px 0 0 var(--blue);
  }

  /* Phone call button is in the bottom contact bar on small screens */
  @media (max-width: 47.99rem) {
    .header-call {
      display: none;
    }
    .brand-tag {
      display: none;
    }
    .brand-logo {
      width: 118px;
    }
  }

  /* Keep logo, language switch and menu on one row on narrow phones */
  @media (max-width: 30rem) {
    .header-inner {
      gap: 0.5rem 0.75rem;
    }
    .lang-switch :global(svg) {
      display: none;
    }
    .lang-switch,
    .menu-toggle {
      padding-inline: 0.6rem;
    }
  }
  @media (max-width: 22rem) {
    .menu-label {
      display: none;
    }
  }

  /* Services dropdown: without JavaScript its links are shown in the list itself. */
  .drop-toggle {
    display: none;
  }
  :global(.no-js) .has-drop,
  :global(.no-js) .drop {
    display: contents;
  }

  @media (min-width: 64rem) {
    .header-inner {
      flex-wrap: nowrap;
      gap: 0.75rem 1rem;
    }
    .menu-toggle,
    .drawer-root {
      display: none;
    }
    .site-nav,
    :global(.js) .site-nav {
      display: block;
      order: 1;
      flex-basis: auto;
    }
    .site-nav > ul {
      display: flex;
      align-items: center;
      gap: 0.1rem;
      padding: 0;
    }
    .site-nav a,
    .drop-toggle {
      border: 0;
      padding: 0.5rem 0.55rem;
      border-radius: var(--radius-s);
      font-size: 0.95rem;
      white-space: nowrap;
    }
    .site-nav a:hover,
    .drop-toggle:hover {
      color: var(--blue-text);
    }
    .site-nav a[aria-current='page'],
    :global([dir='rtl']) .site-nav a[aria-current='page'],
    .drop-toggle.is-current {
      color: var(--blue-text);
      box-shadow: inset 0 -3px 0 var(--blue);
      padding-inline-start: 0.55rem;
      border-radius: 0;
    }
    :global(.js) .has-drop {
      position: relative;
    }
    :global(.js) .drop-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      min-height: 2.75rem;
      background: none;
      color: var(--navy);
      font-family: inherit;
      font-weight: 600;
      line-height: inherit;
      cursor: pointer;
    }
    .drop-toggle :global(.chev) {
      flex: none;
      width: 1rem;
      height: 1rem;
      transition: transform 0.2s ease;
    }
    .drop-toggle[aria-expanded='true'] :global(.chev) {
      transform: rotate(180deg);
    }
    :global(.js) .drop {
      display: none;
      position: absolute;
      inset-block-start: calc(100% + 0.35rem);
      inset-inline-start: 0;
      z-index: 45;
      min-width: 15rem;
      margin: 0;
      padding: 0.35rem;
      list-style: none;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-m);
      box-shadow: 0 12px 28px rgba(7, 38, 65, 0.16);
    }
    :global(.js) .has-drop.is-open .drop {
      display: block;
    }
    .site-nav .drop a {
      display: block;
      padding: 0.65rem 0.75rem;
      border-radius: var(--radius-s);
    }
    .site-nav .drop a:hover {
      background: var(--mist);
    }
    .site-nav .drop a[aria-current='page'] {
      background: var(--blue-tint);
      box-shadow: inset 3px 0 0 var(--blue);
      padding-inline-start: 0.75rem;
    }
    :global([dir='rtl']) .site-nav .drop a[aria-current='page'] {
      box-shadow: inset -3px 0 0 var(--blue);
    }
  }
  /* Small laptops and tablets in landscape: tighter spacing so the bar stays on one line. */
  @media (min-width: 64rem) and (max-width: 74.99rem) {
    .brand-tag {
      display: none;
    }
    .header-inner {
      gap: 0.75rem 0.6rem;
    }
    .site-nav a,
    .drop-toggle,
    .site-nav a[aria-current='page'],
    :global([dir='rtl']) .site-nav a[aria-current='page'],
    .drop-toggle.is-current {
      padding-inline: 0.45rem;
    }
    .header-call {
      padding-inline: 1rem;
    }
  }

  /* ---------- Drawer (mobile and tablet) ---------- */
  .drawer-root {
    position: fixed;
    inset: 0;
    z-index: 80; /* above the sticky header (40) and the floating contact controls (50) */
  }
  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 26, 46, 0.55);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  /* Anchored to the physical right edge in both languages. */
  .drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50vw;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-left: 1px solid var(--line);
    box-shadow: -8px 0 24px rgba(7, 38, 65, 0.18);
    padding: max(0.5rem, env(safe-area-inset-top, 0px)) 0.75rem max(1rem, env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }
  .drawer-root.is-open .drawer {
    transform: translateX(0);
  }
  .drawer-root.is-open .drawer-backdrop {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer-backdrop {
      transition: none;
    }
  }
  /* The page behind does not scroll while the drawer is open. */
  :global(html.drawer-open),
  :global(html.drawer-open body) {
    overflow: hidden;
  }
  .drawer-top {
    display: flex;
    direction: ltr; /* close button sits top-right in both languages */
    justify-content: flex-end;
  }
  .drawer-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius-m);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
  }
  .drawer-close :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .drawer-logo {
    display: flex;
    justify-content: center;
    padding-block: 0.35rem 0.75rem;
  }
  .drawer-logo :global(img) {
    width: min(118px, 100%);
    height: auto;
  }
  .drawer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drawer-nav > ul {
    border-block-start: 1px solid var(--line);
  }
  .drawer-nav li {
    border-block-end: 1px solid var(--line);
  }
  .drawer-nav a,
  .sub-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.25rem;
    box-sizing: border-box;
    color: var(--navy);
    font: inherit;
    font-weight: 600;
    line-height: 1.3;
    text-align: start;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .drawer-nav a:hover,
  .sub-toggle:hover {
    color: var(--blue-text);
  }
  .sub-toggle span {
    flex: 1;
  }
  /* Group whose parent is an overview page: the label links to it, the chevron expands the group. */
  .group-row {
    display: flex;
    align-items: stretch;
  }
  .group-row .group-link {
    flex: 1;
    min-width: 0;
  }
  .sub-toggle.chev-only {
    flex: none;
    width: 44px;
    justify-content: center;
    padding: 0;
    border-inline-start: 1px solid var(--line);
  }
  .drawer-nav a.action :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--blue-text);
  }
  .drawer-lang {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-block-start: 1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .drawer-lang:lang(ar) {
    font-family: var(--font-ar);
  }
  .drawer-lang:lang(en) {
    font-family: var(--font);
  }
  .drawer-lang :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
