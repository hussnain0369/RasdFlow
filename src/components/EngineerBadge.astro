---
/** Engineer portrait if supplied in src/assets/team/, otherwise an initials badge (never a stand-in photo). */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { business } from '../config/business';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  size?: 'l' | 's';
}
const { lang, size = 'l' } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = business.engineer.photo ? photos[`../assets/team/${business.engineer.photo}`]?.default : undefined;
const name = business.engineer.name[lang];
const initials = business.engineer.name.en
  .replace(/^Engineer\s+/i, '')
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
{
  photo ? (
    <Picture src={photo} alt={name} widths={[320, 640]} sizes={size === 'l' ? '20rem' : '6rem'} formats={['avif', 'webp']} class:list={['portrait', size]} />
  ) : (
    <div class:list={['badge', size]} aria-hidden="true">
      <span>{initials}</span>
    </div>
  )
}

<style>
  .badge {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 25%, rgba(92, 184, 240, 0.45), transparent 55%),
      var(--navy);
    color: var(--white);
    font-weight: 800;
    font-stretch: 112%;
    font-family: var(--font);
    letter-spacing: 0.02em;
    box-shadow: 0 0 0 6px var(--white), 0 0 0 9px var(--blue);
  }
  .badge.l {
    width: min(16rem, 60vw);
    font-size: 4rem;
  }
  .badge.s {
    width: 5.5rem;
    font-size: 1.6rem;
    box-shadow: 0 0 0 4px var(--white), 0 0 0 6px var(--blue);
  }
  :global(.portrait) {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }
  :global(.portrait.l) {
    width: min(16rem, 60vw);
  }
  :global(.portrait.s) {
    width: 5.5rem;
  }
</style>
