---
/** Confirmed detection methods only (business.methods). Compact cards or full explanations. */
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Illustration from './Illustration.astro';
import thermalPhoto from '../assets/photos/equipment-thermal.jpg';
import acousticPhoto from '../assets/photos/equipment-acoustic.jpg';
import { methodsFor, methodsSection } from '../content/services';
import type { MethodKey } from '../config/business';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  keys?: MethodKey[];
  variant?: 'compact' | 'full';
  /** Heading level for method titles. */
  level?: 'h3' | 'h4';
  images?: boolean;
}
const { lang, keys, variant = 'compact', level = 'h3', images = true } = Astro.props;
const list = methodsFor(lang, keys);
const icons: Record<MethodKey, 'sound' | 'thermal' | 'pressure' | 'pin'> = {
  acoustic: 'sound',
  thermal: 'thermal',
  pressure: 'pressure',
  underground: 'pin',
};
const pics = {
  acoustic: {
    src: acousticPhoto,
    focus: '38% 60%',
    alt: {
      en: 'Illustration of acoustic leak detection: a technician wearing headphones listens through a ground sensor placed on courtyard paving',
      ar: 'صورة توضيحية للكشف الصوتي: فنّي يرتدي سماعات ويستمع عبر حسّاس موضوع على بلاط الحوش',
    },
  },
  thermal: {
    src: thermalPhoto,
    focus: '62% 45%',
    alt: {
      en: 'Illustration of thermal imaging: a technician points an infrared camera at a bathroom wall with a damp stain near the floor',
      ar: 'صورة توضيحية للتصوير الحراري: فنّي يوجّه كاميرا حرارية نحو جدار حمّام عليه أثر رطوبة قرب الأرضية',
    },
  },
} as Partial<Record<MethodKey, { src: ImageMetadata; focus: string; alt: { en: string; ar: string } }>>;
const H = level;
const labels = methodsSection[lang];
---
{
  list.length > 0 &&
    (variant === 'compact' ? (
      <ul class="methods-compact">
        {list.map((m) => (
          <li>
            <span class="m-icon"><Icon name={icons[m.key]} /></span>
            <H class="m-title">{m.title}</H>
            <p>{m.short}</p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="methods-full">
        {list.map((m) => {
          const pic = images ? pics[m.key] : undefined;
          return (
            <article class:list={['method', { 'has-pic': pic }]}>
              <div class="method-text">
                <H class="m-title">
                  <Icon name={icons[m.key]} class="inline-icon" />
                  <span>{m.title}</span>
                </H>
                <p class="m-short">{m.short}</p>
                <dl class="m-facts">
                  <dt>{labels.when}</dt>
                  <dd>{m.when}</dd>
                  <dt>{labels.tells}</dt>
                  <dd>{m.tells}</dd>
                  <dt>{labels.limits}</dt>
                  <dd>{m.limits}</dd>
                </dl>
              </div>
              {pic && (
                <Illustration
                  lang={lang}
                  src={pic.src}
                  alt={pic.alt[lang]}
                  widths={[400, 700]}
                  sizes="(min-width: 56rem) 22rem, 100vw"
                  focus={pic.focus}
                  class="method-pic"
                />
              )}
            </article>
          );
        })}
      </div>
    ))
}

<style>
  .methods-compact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }
  .methods-compact li {
    padding-block-start: 1.25rem;
    border-block-start: 3px solid var(--navy);
  }
  .m-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--blue-tint);
    color: var(--blue-text);
    margin-block-end: 0.85rem;
  }
  .m-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .m-title {
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--navy);
    margin: 0 0 0.4rem;
  }
  .methods-full {
    display: grid;
    gap: 2.25rem;
  }
  .method {
    display: grid;
    gap: 1.25rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }
  .method:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }
  @media (min-width: 56rem) {
    .method.has-pic {
      grid-template-columns: 1fr 22rem;
      gap: 2.5rem;
      align-items: start;
    }
  }
  .method-text p + p,
  .method-text .m-title + p {
    margin-block-start: 0.6rem;
  }
  .m-short {
    margin-block-start: 0.4rem;
  }
  .m-facts {
    margin: 0.9rem 0 0;
  }
  .m-facts dt {
    margin-block-start: 0.75rem;
    font-weight: 700;
    color: var(--navy);
    font-size: var(--step--1);
  }
  .m-facts dd {
    margin: 0.2rem 0 0;
  }
  .method .m-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .method :global(.inline-icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--blue);
    flex: none;
  }
  .method :global(.method-pic img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
  }
</style>
