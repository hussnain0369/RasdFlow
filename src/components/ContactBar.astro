---
/**
 * Floating contact buttons (email, telephone, WhatsApp), stacked in the
 * bottom corner on every screen size. Only configured methods render.
 * The footer reserves space underneath so the buttons never hide the end of the page.
 */
import Icon from './Icon.astro';
import { contact, whatsappHref } from '../config/business';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const wa = whatsappHref(lang);
---
{
  (contact.phone || wa || contact.email) && (
    <nav class="fab-stack" aria-label={ui.contactBarLabel}>
      {contact.email && (
        <a href={contact.email.href} class="fab fab--email" aria-label={ui.email} title={ui.email}>
          <Icon name="mail" />
        </a>
      )}
      {contact.phone && (
        <a href={contact.phone.href} class="fab fab--call" aria-label={ui.call} title={ui.call}>
          <Icon name="phone" />
        </a>
      )}
      {wa && (
        <a href={wa} class="fab fab--wa" rel="noopener" target="_blank" aria-label={ui.whatsapp} title={ui.whatsapp}>
          <Icon name="chat" />
        </a>
      )}
    </nav>
  )
}
{
  (contact.phone || wa) && (
    <nav class="bottom-bar" aria-label={ui.contactBarLabel}>
      {contact.phone && (
        <a href={contact.phone.href} class="bar-call">
          <Icon name="phone" />
          <span>{ui.call}</span>
        </a>
      )}
      {wa && (
        <a href={wa} class="bar-wa" rel="noopener" target="_blank">
          <Icon name="chat" />
          <span>{ui.whatsappShort}</span>
        </a>
      )}
    </nav>
  )
}

<script>
  // Hide the floating buttons while a page's own large contact buttons
  // (marked data-hides-fab) are on screen, so the two never overlap.
  const stacks = document.querySelectorAll<HTMLElement>('.fab-stack, .bottom-bar');
  const targets = document.querySelectorAll('[data-hides-fab]');
  if (stacks.length && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
      stacks.forEach((el) => el.classList.toggle('is-hidden', visible.size > 0));
    });
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style>
  .fab-stack.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
  }
  .fab-stack {
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    --fab: 3.5rem;
    position: fixed;
    inset-inline-end: max(1rem, env(safe-area-inset-right, 0px));
    inset-block-end: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .fab {
    display: grid;
    place-items: center;
    width: var(--fab);
    height: var(--fab);
    border-radius: 50%;
    color: var(--white);
    box-shadow: 0 4px 14px rgba(7, 38, 65, 0.28);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .fab:hover {
    color: var(--white);
    transform: scale(1.06);
  }
  .fab:focus-visible {
    outline: 3px solid var(--navy);
    outline-offset: 3px;
    border-radius: 50%;
  }
  .fab :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    stroke-width: 1.9;
  }
  .fab--email {
    background: var(--blue-text);
  }
  .fab--call {
    background: var(--navy);
  }
  /* WhatsApp green, darkened so the white icon keeps at least 3:1 contrast */
  .fab--wa {
    background: #138b4f;
  }
  .fab--wa:hover {
    background: #0f7542;
  }
  /* Phones: a slim full-width bar instead of floating buttons, so body text is never covered.
     The footer reserves its height (see --contact-bar-h). */
  .bottom-bar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .fab-stack {
      display: none;
    }
    .bottom-bar {
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 50;
      display: flex;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom, 0px));
      background: var(--navy);
      transition: transform 0.2s ease, visibility 0.2s;
    }
    .bottom-bar.is-hidden {
      transform: translateY(100%);
      visibility: hidden;
    }
    .bottom-bar a {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 3rem;
      padding-inline: 0.5rem;
      border-radius: var(--radius-m);
      font-weight: 650;
      color: var(--white);
      text-decoration: none;
      white-space: nowrap;
    }
    .bottom-bar :global(svg) {
      width: 1.2rem;
      height: 1.2rem;
    }
    .bar-call {
      background: #0a79c2;
    }
    .bar-wa {
      background: #138b4f;
    }
  }
  @media (min-width: 64rem) {
    .fab-stack {
      inset-inline-end: 1.5rem;
      inset-block-end: 1.5rem;
    }
  }
</style>
