---
/**
 * Completed work and customer reviews. Both render nothing until the business
 * supplies approved, real entries in src/config/business.ts.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { business } from '../config/business';
import { methodsFor } from '../content/services';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ar = lang === 'ar';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{jpg,jpeg,png,webp}', { eager: true });
const methodName = (k: string) => methodsFor(lang).find((m) => m.key === k)?.title ?? '';
const projects = business.projects;
const reviews = business.reviews.filter((r) => r.text[lang]);
const L = ar
  ? { work: 'أعمال منجزة', problem: 'المشكلة المبلّغ عنها', method: 'طريقة الكشف', findings: 'النتائج', repair: 'الإصلاح', outcome: 'النتيجة', reviews: 'آراء العملاء', profile: 'اقرأ التقييمات على الملف الموثّق', source: 'المصدر' }
  : { work: 'Completed Work', problem: 'Reported problem', method: 'Detection method', findings: 'Findings', repair: 'Repair', outcome: 'Outcome', reviews: 'What Customers Say', profile: 'Read reviews on our verified profile', source: 'Source' };
---
{
  projects.length > 0 && (
    <section class="section" aria-labelledby="work-title">
      <div class="wrap">
        <h2 id="work-title">{L.work}</h2>
        <div class="projects">
          {projects.map((p) => {
            const img = p.photo ? photos[`../assets/projects/${p.photo}`]?.default : undefined;
            return (
              <article class="project">
                {img && p.photoAlt && <Picture src={img} alt={p.photoAlt[lang]} widths={[400, 800]} sizes="(min-width: 56rem) 40vw, 100vw" formats={['avif', 'webp']} />}
                {p.district && <h3>{p.district[lang]}</h3>}
                <dl>
                  <dt>{L.problem}</dt><dd>{p.problem[lang]}</dd>
                  <dt>{L.method}</dt><dd>{p.method.map(methodName).filter(Boolean).join(ar ? '، ' : ', ')}</dd>
                  <dt>{L.findings}</dt><dd>{p.findings[lang]}</dd>
                  <dt>{L.repair}</dt><dd>{p.repair[lang]}</dd>
                  <dt>{L.outcome}</dt><dd>{p.outcome[lang]}</dd>
                </dl>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}
{
  (reviews.length > 0 || business.reviewProfileUrl) && (
    <section class="section section--mist" aria-labelledby="reviews-title">
      <div class="wrap">
        <h2 id="reviews-title">{L.reviews}</h2>
        {reviews.length > 0 && (
          <ul class="reviews">
            {reviews.map((r) => (
              <li>
                <blockquote>
                  <p>{r.text[lang]}</p>
                </blockquote>
                <p class="author">
                  {r.author}
                  {r.sourceUrl && (<> · <a href={r.sourceUrl} rel="noopener">{L.source}</a></>)}
                </p>
              </li>
            ))}
          </ul>
        )}
        {business.reviewProfileUrl && (
          <p class="profile">
            <a class="link-arrow" href={business.reviewProfileUrl} rel="noopener">
              <span>{L.profile}</span>
              <Icon name="arrow" />
            </a>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  h2 {
    margin-block-end: 2rem;
  }
  .projects {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  .project :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
    margin-block-end: 1rem;
  }
  .project h3 {
    font-size: var(--step-1);
    margin-block-end: 0.75rem;
  }
  dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-block-start: 0.6rem;
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  }
  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 4px solid var(--blue);
  }
  .author {
    margin-block-start: 0.6rem;
    font-weight: 650;
    color: var(--navy);
  }
  .profile {
    margin-block-start: 2rem;
  }
</style>
