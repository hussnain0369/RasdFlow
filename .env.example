# Copy to .env (never commit real values).

# Origin only (no path), no trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL=

# Sub-folder the site is served from. Leave empty for a domain root; /RasdFlow/ on GitHub Pages.
BASE_PATH=

# Set to "production" ONLY on the live deployment. Any other value (or none) adds
# noindex to every page and makes robots.txt disallow crawling.
DEPLOY_ENV=

# Enquiry form delivery (https://resend.com). The form is hidden unless all three are set
# at build time, and the server route refuses submissions unless they are set at run time.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=

# Optional: a separate inbox for customer feedback. Falls back to ENQUIRY_TO_EMAIL.
# The feedback form appears only when RESEND_API_KEY, ENQUIRY_FROM_EMAIL and one of these inboxes are set.
FEEDBACK_TO_EMAIL=

# Testing only: send form emails to a local stand-in instead of Resend. Leave empty in production.
RESEND_API_URL=
