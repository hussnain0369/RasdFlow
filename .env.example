# Copy to .env (never commit real values).

# Production origin, no trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL=

# Set to "production" ONLY on the live deployment. Any other value (or none) adds
# noindex to every page and makes robots.txt disallow crawling.
DEPLOY_ENV=

# Enquiry form delivery (https://resend.com). The form is hidden unless all three are set
# at build time, and the server route refuses submissions unless they are set at run time.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=
